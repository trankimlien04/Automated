# ========================================================
# SMART LIBRARY - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and change the secrets before running
# ========================================================

# Application Port (Web Frontend Nginx)
APP_PORT=8088

# Backend API Port
BACKEND_PORT=5001

# Database Configuration (MySQL)
DB_ROOT_PASSWORD=your_password
DB_NAME=smart_library
DB_EXTERNAL_PORT=3308

# JWT Authentication
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Timezone & Frontend URL (dùng cho Cron 08:00 và link nút trong Email)
TZ=Asia/Ho_Chi_Minh
LIBRARY_TIMEZONE=Asia/Ho_Chi_Minh
FRONTEND_URL=http://localhost:8088

# Automated Email Notifications (SMTP - Gmail App Password hoặc SMTP tùy chỉnh)
# Ngoài ra Admin/Chủ thư viện có thể nhập trực tiếp trên giao diện Thông báo -> Cấu hình SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Athenaeum Smart Library <your_email@gmail.com>